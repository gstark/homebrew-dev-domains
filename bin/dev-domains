#!/usr/bin/env bash
set -euo pipefail

ROOT_PLACEHOLDER="__DEV_DOMAINS_ROOT__"
ROOT="${DEV_DOMAINS_ROOT:-$ROOT_PLACEHOLDER}"
if [[ "$ROOT" == "$ROOT_PLACEHOLDER" ]]; then
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_ROOT="${DEV_DOMAINS_CONFIG_DIR:-$CONFIG_HOME/dev-domains}"
CADDYFILE="$CONFIG_ROOT/Caddyfile"
APPS_DIR="$CONFIG_ROOT/apps"
TEMPLATE_CADDYFILE="$ROOT/caddy/Caddyfile"
BASE_DOMAIN="${DEV_DOMAINS_BASE_DOMAIN:-lvh.me}"

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: required command not found: $1" >&2
    exit 1
  fi
}

system_caddyfile_path() {
  local brew_prefix=""

  if command -v brew >/dev/null 2>&1; then
    brew_prefix="$(brew --prefix 2>/dev/null || true)"
  fi

  if [[ -z "$brew_prefix" ]]; then
    if [[ -d /opt/homebrew/etc ]]; then
      brew_prefix="/opt/homebrew"
    else
      brew_prefix="/usr/local"
    fi
  fi

  printf '%s/etc/Caddyfile' "$brew_prefix"
}

ensure_config_dir() {
  mkdir -p "$APPS_DIR"

  if [[ ! -f "$CADDYFILE" ]]; then
    cp "$TEMPLATE_CADDYFILE" "$CADDYFILE"
    echo "Created $CADDYFILE"
  fi
}

install_system_caddyfile_loader() {
  local system_caddyfile
  system_caddyfile="$(system_caddyfile_path)"
  mkdir -p "$(dirname "$system_caddyfile")"

  if [[ -f "$system_caddyfile" ]] && ! grep -Fq "$CADDYFILE" "$system_caddyfile"; then
    local backup
    backup="$system_caddyfile.dev-domains.bak"
    cp "$system_caddyfile" "$backup"
    echo "Backed up existing system Caddyfile to $backup"
  fi

  cat > "$system_caddyfile" <<EOF
import $CADDYFILE
EOF

  echo "Updated system Caddyfile: $system_caddyfile"
}

app_file_for_name() {
  printf '%s/%s.caddy' "$APPS_DIR" "$1"
}

app_hostname_for_name() {
  printf '%s.%s' "$1" "$BASE_DOMAIN"
}

app_url_for_name() {
  printf 'http://%s' "$(app_hostname_for_name "$1")"
}

list_apps() {
  if [[ ! -d "$APPS_DIR" ]]; then
    return 0
  fi

  local found=0
  shopt -s nullglob
  for file in "$APPS_DIR"/*.caddy; do
    found=1
    local name port
    name="$(basename "$file" .caddy)"
    port="$(grep -Eo 'localhost:[0-9]+' "$file" | head -n1 | cut -d: -f2 || true)"
    printf '%s\t%s\t%s\n' "$name" "$(app_url_for_name "$name")" "${port:-unknown}"
  done
  shopt -u nullglob

  if [[ "$found" -eq 0 ]]; then
    echo "No app configs found in $APPS_DIR"
  fi
}

edit_app() {
  local name=""
  local port=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --port)
        port="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "Usage: dev-domains edit-app --name NAME --port PORT"
        return 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "$name" || -z "$port" ]]; then
    echo "Usage: dev-domains edit-app --name NAME --port PORT" >&2
    return 1
  fi

  ensure_config_dir

  local file
  file="$(app_file_for_name "$name")"
  if [[ ! -f "$file" ]]; then
    echo "App config not found: $file" >&2
    return 1
  fi

  cat > "$file" <<EOF
$(app_hostname_for_name "$name") {
	reverse_proxy localhost:$port
}
EOF

  echo "Updated $file"
  echo "Next: reload Caddy with 'dev-domains reload'"
}

remove_app() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "Usage: dev-domains remove-app --name NAME"
        return 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "Usage: dev-domains remove-app --name NAME" >&2
    return 1
  fi

  local file
  file="$(app_file_for_name "$name")"
  if [[ ! -f "$file" ]]; then
    echo "App config not found: $file" >&2
    return 1
  fi

  rm "$file"
  echo "Removed $file"
  echo "Next: reload Caddy with 'dev-domains reload'"
}

open_app() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "Usage: dev-domains open --name NAME"
        return 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "Usage: dev-domains open --name NAME" >&2
    return 1
  fi

  require_cmd open
  open "$(app_url_for_name "$name")"
}

setup_cmd() {
  require_cmd brew
  require_cmd caddy

  ensure_config_dir
  install_system_caddyfile_loader

  echo "Using lvh.me hostnames with base domain: $BASE_DOMAIN"
  echo "No dnsmasq or /etc/resolver setup is required for lvh.me."
  echo
  echo "Starting Caddy via Homebrew..."
  brew services restart caddy || brew services start caddy
  echo
  echo "Done. Next steps:"
  echo "  1. Create an app config: dev-domains new-app --name myapp --port 3000"
  echo "  2. Start your dev server"
  echo "  3. Open: http://myapp.$BASE_DOMAIN"
}

new_app() {
  local name=""
  local port=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --port)
        port="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "Usage: dev-domains new-app --name NAME --port PORT"
        return 0
        ;;
      *)
        echo "Unknown argument: $1" >&2
        return 1
        ;;
    esac
  done

  if [[ -z "$name" || -z "$port" ]]; then
    echo "Usage: dev-domains new-app --name NAME --port PORT" >&2
    return 1
  fi

  ensure_config_dir

  local file
  file="$(app_file_for_name "$name")"

  if [[ -e "$file" ]]; then
    echo "Refusing to overwrite existing file: $file" >&2
    return 1
  fi

  cat > "$file" <<EOF
$(app_hostname_for_name "$name") {
	reverse_proxy localhost:$port
}
EOF

  echo "Created $file"
  echo "URL: $(app_url_for_name "$name")"
  echo "Next: reload Caddy with 'dev-domains reload'"
}

service_state() {
  local service="$1"
  if ! command -v brew >/dev/null 2>&1; then
    echo "unknown"
    return 0
  fi

  local line
  line="$(brew services list 2>/dev/null | awk -v svc="$service" '$1 == svc {print}')"
  if [[ -z "$line" ]]; then
    echo "not-installed"
  else
    echo "$line" | awk '{print $2}'
  fi
}

status() {
  echo "dev-domains status"
  echo
  echo "Paths:"
  echo "  root:             $ROOT"
  echo "  config root:      $CONFIG_ROOT"
  echo "  caddyfile:        $CADDYFILE"
  echo "  apps:             $APPS_DIR"
  echo "  system caddyfile: $(system_caddyfile_path)"
  echo
  echo "Hostnames:"
  echo "  base:      $BASE_DOMAIN"
  echo "  pattern:   <name>.$BASE_DOMAIN"
  echo
  echo "Services:"
  echo "  caddy:   $(service_state caddy)"
  echo
  echo "Apps:"
  list_apps
}

doctor() {
  local name="${1:-flux}"
  local host
  host="$(app_hostname_for_name "$name")"
  echo "dev-domains doctor"
  echo

  local missing=0
  for cmd in brew caddy dig; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "[ok] command found: $cmd"
    else
      echo "[missing] command not found: $cmd"
      missing=1
    fi
  done

  if [[ -f "$CADDYFILE" ]]; then
    echo "[ok] config exists: $CADDYFILE"
  else
    echo "[warn] config not found: $CADDYFILE"
    missing=1
  fi

  if [[ -f "$(system_caddyfile_path)" ]] && grep -Fq "$CADDYFILE" "$(system_caddyfile_path)"; then
    echo "[ok] system Caddyfile loads dev-domains config"
  else
    echo "[warn] system Caddyfile is not loading $CADDYFILE"
    missing=1
  fi

  if [[ "$(service_state caddy)" == "started" ]]; then
    echo "[ok] caddy service is started"
  else
    echo "[warn] caddy service does not appear started"
  fi

  if command -v dig >/dev/null 2>&1; then
    if dig +short "$host" | grep -Eq '^(127\.0\.0\.1|::1)$'; then
      echo "[ok] DNS resolves for $host"
    else
      echo "[warn] DNS did not resolve $host to 127.0.0.1 or ::1"
      missing=1
    fi
  fi

  echo
  if [[ "$missing" -eq 0 ]]; then
    echo "Doctor check passed."
  else
    echo "Doctor found issues. See docs/troubleshooting.md"
    return 1
  fi
}

usage() {
  cat <<EOF
Usage: dev-domains <command> [args]

Commands:
  setup                             Create ~/.config/dev-domains and point system Caddyfile at it
  install-and-setup                 Install caddy, then run setup
  run                               Run Caddy with the user config
  reload                            Reload Caddy with the user config
  validate                          Validate the user Caddy config
  trust                             Trust Caddy's local CA for HTTPS
  new-app --name NAME --port PORT   Create a new app config file
  edit-app --name NAME --port PORT  Update an app's port
  list-apps                         List app configs
  remove-app --name NAME            Remove an app config file
  open --name NAME                  Open an app in the browser
  status                            Show Caddy status and configured apps
  doctor [name]                     Verify local setup, optionally testing NAME.$BASE_DOMAIN
  paths                             Print important installed paths
  help                              Show this help
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  setup)
    setup_cmd
    ;;
  install-and-setup)
    brew install caddy
    setup_cmd
    ;;
  run)
    ensure_config_dir
    exec caddy run --config "$CADDYFILE"
    ;;
  reload)
    ensure_config_dir
    exec caddy reload --config "$CADDYFILE"
    ;;
  validate)
    ensure_config_dir
    exec caddy validate --config "$CADDYFILE"
    ;;
  trust)
    exec caddy trust
    ;;
  new-app)
    new_app "$@"
    ;;
  edit-app)
    edit_app "$@"
    ;;
  list-apps)
    list_apps
    ;;
  remove-app)
    remove_app "$@"
    ;;
  open)
    open_app "$@"
    ;;
  status)
    status
    ;;
  doctor)
    doctor "$@"
    ;;
  paths)
    cat <<EOF
Install root:      $ROOT
Config root:       $CONFIG_ROOT
Caddyfile:         $CADDYFILE
App configs:       $APPS_DIR
System Caddyfile:  $(system_caddyfile_path)
Docs:              $ROOT/docs
EOF
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
